# Copy to .env and fill in values. Never commit real .env files.

# Required for /analyze
GEMINI_API_KEY=
NEWSDATA_API_KEY=

# Optional: Perplexity (only if you call perplexity_service.call_perplexity)
PERPLEXITY_API_KEY=

# Comma-separated list — no wildcards. Add your Vercel / production front-end URLs.
# Example:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# production | development — affects docs hints only
ENVIRONMENT=development

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Frontend (Vite) — create src/.env (not this file) with: ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Production build: set to your public API URL (no trailing slash).
