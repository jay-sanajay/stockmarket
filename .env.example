# Copy to .env and fill in values. Never commit real .env files.

# Required for /analyze
GEMINI_API_KEY=
NEWSDATA_API_KEY=

# Optional: override Gemini model (default tries gemini-2.0-flash, then newer fallbacks)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Perplexity (only if you call perplexity_service.call_perplexity)
PERPLEXITY_API_KEY=

# Comma-separated list — no wildcards. Add your Vercel / production front-end URLs.
# Example:
# Production example (Render API):
# CORS_ORIGINS=https://stockmarket-rho.vercel.app
# Preview deploys are allowed automatically on Render (RENDER=true) via CORS regex — see config.py
# CORS_VERCEL_REGEX=0  # set on Render only if you must disable *.vercel.app matching
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# production | development — affects docs hints only
ENVIRONMENT=development

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: cache full /analyze results (seconds). On Fly.io / Render, default is 1800 (30m) if unset.
# ANALYSIS_CACHE_TTL=3600

# Optional: skip Gemini for news sentiment — use keyword heuristic only (fewer Gemini calls on shared IPs).
# SKIP_GEMINI_SENTIMENT=1

# --- Frontend (Vite) — optional src/.env for local overrides only ---
# Production (Vercel): set VITE_API_BASE_URL in Vercel Project → Environment Variables
# to your deployed API, e.g. https://yourapp.onrender.com (no trailing slash).
# Local dev: leave unset to use Vite proxy (vite.config.js).
